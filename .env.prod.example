# Production Environment Configuration Example
# Copy to .env.prod and update values as needed.

NODE_ENV=production
PRODUCTION=true

# Backend API Endpoint URL
BACKEND_URL=https://quaservicesp.procucev.com
API_ENDPOINT=https://quaservicesp.procucev.com

# Local Storage Encryption Key
STORAGE_ENCRYPTION_KEY=your_prod_storage_encryption_key

# Client Basic Auth Header
BASIC_AUTH_TOKEN=your_prod_basic_auth_token

# Proxy Target for ng serve
PROXY_TARGET=https://quaservicesp.procucev.com
